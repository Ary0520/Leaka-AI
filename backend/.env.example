# ========== DATABASE ==========
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/revguard

# ========== REDIS / CELERY ==========
REDIS_URL=redis://localhost:6379/0
REDIS_RESULT_BACKEND=redis://localhost:6379/1

# ========== LLM - PRODUCTION MODE ==========
# Pick any one or more — used by browser-use Agent via from_env
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# LLM provider selection: "openai" | "anthropic" | "openrouter"
LLM_PROVIDER=openai

# Model names per provider
LLM_MODEL_OPENAI=gpt-4.1-mini
LLM_MODEL_ANTHROPIC=claude-sonnet-4-0
LLM_MODEL_OPENROUTER=anthropic/claude-sonnet-4.5

# ========== LLM - BOOTSTRAPPER (OLLAMA LOCAL) ==========
# Set LLM_PROVIDER=ollama to use this — 100% free, runs locally
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# ========== BROWSER-USE ==========
# Optional: Cloud API key for hosted browsers / BU models (NOT required — use open-source)
BROWSER_USE_API_KEY=

# ========== ENTERPRISE INTEGRATIONS ==========
# Linear (GraphQL)
LINEAR_API_KEY=
LINEAR_TEAM_ID=

# Resend (Email notifications)
RESEND_API_KEY=
EMAIL_FROM=Leaka AI <qa@leaka.ai>
EMAIL_ALERT_TO=

# Slack (optional)
SLACK_WEBHOOK_URL=

# ========== CI / WEBHOOKS ==========
CI_WEBHOOK_TOKEN=revguard-ci-token-change-me

# ========== MISC ==========
SCREENSHOT_DIR=screenshots
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
