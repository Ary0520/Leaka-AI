{
  "manifest_version": 3,
  "name": "Leaka AI Agent Recorder",
  "version": "1.0.0",
  "description": "Records user actions into Natural Language Prompts & securely extracts session cookies for Leaka AI testing.",
  "permissions": ["activeTab", "scripting", "storage", "cookies"],
  "host_permissions": ["<all_urls>", "http://localhost:8000/*", "https://api.leaka.ai/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Leaka AI"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["main_world_capture.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
