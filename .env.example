# copy this file to .env and fill in values

# ========== LLM ==========
# Choose: openai | anthropic | openrouter | ollama
LLM_PROVIDER=ollama

# Production API keys (skip if using ollama)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

LLM_MODEL_OPENAI=gpt-4.1-mini
LLM_MODEL_ANTHROPIC=claude-sonnet-4-0
LLM_MODEL_OPENROUTER=anthropic/claude-sonnet-4.5

# Ollama (local LLM, 100% free bootstrapper)
# Install from https://ollama.com/download then run: `ollama pull qwen2.5-coder:7b`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# ========== INTEGRATIONS ==========
LINEAR_API_KEY=
LINEAR_TEAM_ID=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_ALERT_TO=
CI_WEBHOOK_TOKEN=revguard-ci-token-change-me

# ========== FRONTEND ==========
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
